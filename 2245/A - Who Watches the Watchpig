import java.util.Scanner;
 
public class Main {
    public static void main(String[] z) {
        Scanner s = new Scanner(System.in);
        if (!s.hasNextInt()) return;
        int t = s.nextInt();
        while (t-- > 0) {
            int n = s.nextInt();
            int k = s.nextInt();
            String w = s.next();
            if (2 * k > n) {
                System.out.println(-1);
                continue;
            }
            int m = Integer.MAX_VALUE;
            for (int a = k; a <= n - k; a++) {
                int u = 0;
                for (int i = 0; i < a; i++) {
                    if (w.charAt(i) == 'L') u++;
                }
                for (int b = k; a + b <= n; b++) {
                    int v = 0;
                    for (int i = n - b; i < n; i++) {
                        if (w.charAt(i) == 'R') v++;
                    }
                    if (u + v < m) m = u + v;
                }
            }
            System.out.println(m);
        }
    }
}